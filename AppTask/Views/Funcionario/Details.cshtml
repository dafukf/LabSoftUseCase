@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Detalhes do funcionário";
}

<h1>Detalhes do funcionário</h1>

<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@Model.Nome</dd>

    <dt class="col-sm-3">Cargo</dt>
    <dd class="col-sm-9">@Model.Cargo</dd>

    <dt class="col-sm-3">Departamento</dt>
    <dd class="col-sm-9">@Model.Departamento?.Nome</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Codigo" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
