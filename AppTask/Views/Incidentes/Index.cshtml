@model IEnumerable<AppTask.Models.Incidente>
@{
    ViewData["Title"] = "Incidentes";

    var total = Model.Count();
    var resolvidos = Model.Count(i => i.Resolvido == "sim");
    var abertos = total - resolvidos;
}

<div class="page-header">
    <div>
        <h1>Incidentes</h1>
        <p class="text-muted">Registro e acompanhamento de incidentes.</p>
    </div>
    <a href="/Incidentes/Create" class="btn btn-success text-white">
        <i class="bi bi-plus-lg"></i> Novo incidente
    </a>
</div>

<div class="stat-row">
    <div class="stat-card accent-total">
        <div class="stat-label"><i class="bi bi-exclamation-triangle"></i> Total</div>
        <div class="stat-value">@total</div>
    </div>
    <div class="stat-card accent-progress">
        <div class="stat-label"><i class="bi bi-hourglass-split"></i> Em aberto</div>
        <div class="stat-value">@abertos</div>
    </div>
    <div class="stat-card accent-done">
        <div class="stat-label"><i class="bi bi-check-circle"></i> Resolvidos</div>
        <div class="stat-value">@resolvidos</div>
    </div>
</div>

<div class="card-panel">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Código</th>
                <th>Descrição do problema</th>
                <th>Data do incidente</th>
                <th>Solução</th>
                <th>Resolvido</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.DescricaoProblema</td>
                    <td>@item.DataIncidente</td>
                    <td>@item.Solucao</td>
                    <td>
                        @if (item.Resolvido == "sim")
                        {
                            <span class="badge-status badge-status-done">Sim</span>
                        }
                        else
                        {
                            <span class="badge-status badge-status-progress">Não</span>
                        }
                    </td>
                    <td>
                        <a href="/Incidentes/Edit/@item.Codigo" class="btn btn-primary btn-sm">
                            Alterar
                        </a>
                        <a href="/Incidentes/Details/@item.Codigo" class="btn btn-success btn-sm text-white">
                            Detalhes
                        </a>
                        <a href="/Incidentes/Delete/@item.Codigo" class="btn btn-danger btn-sm">
                            Excluir
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
