@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefas";

    /*
        -------------------------------------------------------
        Função responsável por determinar a classe visual
        do status da tarefa.
        -------------------------------------------------------
    */

    string BadgeClass(string status)
    {
        var s = (status ?? "").ToLower();

        if (s.Contains("inic") || s.Contains("andamento"))
            return "badge-status badge-status-progress";

        if (s.Contains("final") || s.Contains("conclu"))
            return "badge-status badge-status-done";

        if (s.Contains("cancel"))
            return "badge-status badge-status-cancelled";

        return "badge-status badge-status-pending";
    }


    /*
        -------------------------------------------------------
        Indicadores da página
        -------------------------------------------------------
    */

    var tarefas = Model.ToList();

    var total = tarefas.Count;

    var emAndamento = tarefas.Count(t =>
        (t.StatusTarefa ?? "")
        .ToLower()
        .Contains("inic")
    );

    var concluidas = tarefas.Count(t =>
        (t.StatusTarefa ?? "")
        .ToLower()
        .Contains("final")
        ||
        (t.StatusTarefa ?? "")
        .ToLower()
        .Contains("conclu")
    );

    var canceladas = tarefas.Count(t =>
        (t.StatusTarefa ?? "")
        .ToLower()
        .Contains("cancel")
    );
}


<!-- =========================================================
     CABEÇALHO
     ========================================================= -->

<div class="page-header">

    <div>

        <h1>Tarefas</h1>

        <p>
            Acompanhe e gerencie as tarefas da equipe.
        </p>

    </div>


    <a asp-controller="Tarefa"
       asp-action="Create"
       class="btn btn-success">

        <i class="bi bi-plus-lg"></i>

        Nova tarefa

    </a>

</div>


<!-- =========================================================
     INDICADORES
     ========================================================= -->

<div class="stat-row">


    <!-- Total -->

    <div class="stat-card accent-total">

        <div class="stat-label">

            <i class="bi bi-list-check"></i>

            Total

        </div>

        <div class="stat-value">

            @total

        </div>

    </div>


    <!-- Em andamento -->

    <div class="stat-card accent-progress">

        <div class="stat-label">

            <i class="bi bi-hourglass-split"></i>

            Em andamento

        </div>

        <div class="stat-value">

            @emAndamento

        </div>

    </div>


    <!-- Concluídas -->

    <div class="stat-card accent-done">

        <div class="stat-label">

            <i class="bi bi-check-circle"></i>

            Concluídas

        </div>

        <div class="stat-value">

            @concluidas

        </div>

    </div>


    <!-- Canceladas -->

    <div class="stat-card accent-cancel">

        <div class="stat-label">

            <i class="bi bi-x-circle"></i>

            Canceladas

        </div>

        <div class="stat-value">

            @canceladas

        </div>

    </div>

</div>


<!-- =========================================================
     TABELA
     ========================================================= -->

<div class="card-panel">

    <table class="table table-hover">

        <thead>

            <tr>

                <th>
                    Descrição
                </th>

                <th>
                    Data planejada
                </th>

                <th>
                    Data iniciada
                </th>

                <th>
                    Data finalizada
                </th>

                <th>
                    Data cancelada
                </th>

                <th>
                    Status
                </th>

                <th>
                    Prazo
                </th>

                <th>
                    Funcionário
                </th>

                <th>
                    Ações
                </th>

            </tr>

        </thead>


        <tbody>

            @if (!tarefas.Any())
            {
                <tr>

                    <td colspan="9"
                        class="text-center py-5">

                        <div>

                            <i class="bi bi-inbox"
                               style="font-size: 32px; color: #938A84;">
                            </i>

                            <div class="mt-2 fw-semibold">
                                Nenhuma tarefa encontrada
                            </div>

                            <div class="text-muted small">
                                Cadastre uma nova tarefa para começar.
                            </div>

                        </div>

                    </td>

                </tr>
            }
            else
            {
                foreach (var item in tarefas)
                {

                    <tr>


                        <!-- Descrição -->

                        <td>

                            <strong>
                                @item.Descricao
                            </strong>

                        </td>


                        <!-- Data planejada -->

                        <td>

                            @item.DataPlanejada.ToString("dd/MM/yyyy")

                        </td>


                        <!-- Data iniciada -->

                        <td>

                            @(item.DataIniciada?.ToString("dd/MM/yyyy") ?? "—")

                        </td>


                        <!-- Data finalizada -->

                        <td>

                            @(item.DataFinalizada?.ToString("dd/MM/yyyy") ?? "—")

                        </td>


                        <!-- Data cancelada -->

                        <td>

                            @(item.DataCancelada?.ToString("dd/MM/yyyy") ?? "—")

                        </td>


                        <!-- Status -->

                        <td>

                            <span class="@BadgeClass(item.StatusTarefa)">

                                @item.StatusTarefa

                            </span>

                        </td>


                        <!-- Prazo -->

                        <td>

                            @item.Prazo

                        </td>


                        <!-- Funcionário -->

                        <td>

                            @(item.Funcionario?.Nome ?? "Não atribuído")

                        </td>


                        <!-- Ações -->

                        <td>

                            <div class="d-flex gap-2">

                                <!-- Editar -->

                                <a asp-controller="Tarefa"
                                   asp-action="Edit"
                                   asp-route-id="@item.Codigo"
                                   class="btn btn-primary btn-sm"
                                   title="Alterar">

                                    <i class="bi bi-pencil"></i>

                                </a>


                                <!-- Detalhes -->

                                <a asp-controller="Tarefa"
                                   asp-action="Details"
                                   asp-route-id="@item.Codigo"
                                   class="btn btn-secondary btn-sm"
                                   title="Detalhes">

                                    <i class="bi bi-eye"></i>

                                </a>


                                <!-- Excluir -->

                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        title="Excluir"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.Codigo"
                                        data-descricao="@item.Descricao">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </div>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>


<!-- =========================================================
     MODAL DE EXCLUSÃO
     ========================================================= -->

<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <!-- Cabeçalho -->

            <div class="modal-header">

                <h5 class="modal-title"
                    id="deleteModalLabel">

                    Excluir tarefa

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>

            </div>


            <!-- Corpo -->

            <div class="modal-body">

                <p class="mb-2">

                    Você está prestes a excluir esta tarefa:

                </p>

                <strong id="tarefaDescricao"></strong>

                <p class="mt-3 mb-0 text-muted">

                    Essa ação não poderá ser desfeita.

                </p>

            </div>


            <!-- Rodapé -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>


                <form id="deleteForm"
                      method="post"
                      action="">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>

                        Excluir

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->
@section Scripts {

    <script>

        const deleteModal =
            document.getElementById("deleteModal");


        if (deleteModal) {

            deleteModal.addEventListener(
                "show.bs.modal",
                function (event) {

                    const button =
                        event.relatedTarget;


                    const id =
                        button.getAttribute("data-id");


                    const descricao =
                        button.getAttribute("data-descricao");


                    const modalDescricao =
                        deleteModal.querySelector(
                            "#tarefaDescricao"
                        );


                    const deleteForm =
                        deleteModal.querySelector(
                            "#deleteForm"
                        );


                    modalDescricao.textContent =
                        descricao;


                    deleteForm.action =
                        "/Tarefa/Delete/" + id;

                }
            );

        }

    </script>

}